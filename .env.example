# Copy to .env and fill in real values. Never commit .env.
# Generate the three secrets with: openssl rand -hex 32
#
# IMPORTANT: the password in DATABASE_URL must be identical to POSTGRES_PASSWORD.
# If you choose a password with special characters, URL-encode it in DATABASE_URL.

NODE_ENV=production
PORT=3000
TZ=Asia/Hong_Kong
LOG_LEVEL=info

# PostgreSQL (inside the compose network the host is "db")
POSTGRES_USER=tally
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=tally
DATABASE_URL=postgres://tally:CHANGE_ME@db:5432/tally

# Shared passcode (>= 32 chars in production) and session signing secret (>= 32 chars).
# These placeholders are deliberately short: production refuses to start until you set them.
APP_PASSCODE=CHANGE_ME
SESSION_SECRET=CHANGE_ME

# Must be true in production. Set false only for plain-HTTP local development.
COOKIE_SECURE=true

# Cloudflare Named Tunnel token (dashboard -> Networks -> Tunnels).
TUNNEL_TOKEN=CHANGE_ME
