{
  "name": "tally",
  "version": "1.0.0",
  "private": true,
  "description": "Tally — Mahjong & Football ledger backend",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/server.js",
    "dev": "tsc -w -p tsconfig.json",
    "start:dev": "node --env-file=.env --watch --enable-source-maps dist/server.js",
    "migrate": "node --env-file=.env dist/migrate.js",
    "import": "node scripts/import-firebase-json.mjs",
    "start:local": "node --env-file=.env dist/server.js"
  },
  "dependencies": {
    "cookie": "2.0.1",
    "express": "5.3.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.1",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
